# Thư mục chứa 4 file CSV (tương đối so với thư mục gốc TTT-BE, hoặc đường dẫn tuyệt đối)
DATA_DIR=data

# Khoá BE NestJS gửi qua header X-Internal-Key (phải trùng bên BE). Để trống = không kiểm khoá (chỉ khi dev).
INTERACTION_INTERNAL_KEY=

# Số thuốc tối đa mỗi lần kiểm tra
MAX_DRUGS_PER_REQUEST=100
